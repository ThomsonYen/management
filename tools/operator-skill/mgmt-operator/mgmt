#!/usr/bin/env python3
"""Call the management app API with the bearer token from the keychain.

    mgmt GET  /agent/digest
    mgmt GET  '/todos?is_focused=true'
    mgmt PUT  /todos/42 '{"status":"done"}'
    mgmt POST /notes '{"title":"Weekly report","kind":"personal","content":"..."}'
    mgmt --dry-run PUT /todos/42 '{"status":"done"}'

Prints only the response body (JSON pretty-printed, markdown as-is). Never
prints headers or the token. Exit 1 on any 4xx/5xx with the body on stdout.

Config (env):
    MGMT_BASE_URL   default https://management-wxisjq.fly.dev/api
    MGMT_TOKEN      overrides the keychain lookup (for non-macOS devices)
Keychain (macOS): service "management-api", account "claude".
Stdlib only, so it runs on any device with python3.
"""

import json
import os
import ssl
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

DEFAULT_BASE = "https://management-wxisjq.fly.dev/api"
METHODS = {"GET", "POST", "PUT", "DELETE"}


def die(msg: str, code: int = 2) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def token() -> str:
    t = os.environ.get("MGMT_TOKEN")
    if t:
        return t.strip()
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "management-api", "-a", "claude", "-w"],
            capture_output=True, text=True, check=True,
        )
        return out.stdout.strip()
    except (FileNotFoundError, subprocess.CalledProcessError):
        die("No token: set MGMT_TOKEN or add one to the keychain "
            "(security add-generic-password -U -s management-api -a claude -w '<token>')")


def ssl_contexts():
    """Yield SSL contexts to try: default, then certifi, then macOS system roots.

    python.org builds on macOS ship without root certs, so the default
    context fails to verify; certifi or the system keychain usually works.
    """
    yield ssl.create_default_context()
    try:
        import certifi  # type: ignore
        yield ssl.create_default_context(cafile=certifi.where())
    except ImportError:
        pass
    try:
        pem = subprocess.run(
            ["security", "find-certificate", "-a", "-p",
             "/System/Library/Keychains/SystemRootCertificates.keychain"],
            capture_output=True, text=True, check=True,
        ).stdout
        with tempfile.NamedTemporaryFile("w", suffix=".pem", delete=False) as f:
            f.write(pem)
        yield ssl.create_default_context(cafile=f.name)
    except (FileNotFoundError, subprocess.CalledProcessError):
        pass


def send(req: urllib.request.Request):
    last = None
    for ctx in ssl_contexts():
        try:
            with urllib.request.urlopen(req, timeout=30, context=ctx) as resp:
                return resp.read(), resp.headers.get("Content-Type", ""), resp.status
        except urllib.error.HTTPError as e:
            return e.read(), e.headers.get("Content-Type", ""), e.code
        except urllib.error.URLError as e:
            last = e
            if not isinstance(e.reason, ssl.SSLCertVerificationError):
                break
    die(f"request failed: {last.reason if last else 'unknown error'}", 1)


def main() -> None:
    args = sys.argv[1:]
    dry = False
    if args and args[0] == "--dry-run":
        dry = True
        args = args[1:]
    if len(args) < 2 or args[0].upper() not in METHODS:
        die(__doc__.strip())
    method, path = args[0].upper(), args[1]
    body = args[2] if len(args) > 2 else None
    if not path.startswith("/"):
        die("path must start with /")
    if body is not None:
        try:
            json.loads(body)
        except json.JSONDecodeError as e:
            die(f"body is not valid JSON: {e}")

    base = os.environ.get("MGMT_BASE_URL", DEFAULT_BASE).rstrip("/")
    url = base + path
    if dry:
        print(f"{method} {url}")
        if body:
            print(json.dumps(json.loads(body), indent=2))
        return

    req = urllib.request.Request(url, method=method, data=body.encode() if body else None)
    req.add_header("Authorization", f"Bearer {token()}")
    req.add_header("Accept", "application/json, text/markdown")
    if body:
        req.add_header("Content-Type", "application/json")
    raw, ctype, status = send(req)

    if status < 400 and not any(k in ctype for k in ("json", "text/")):
        # binary (e.g. the /agent/skill tarball): pass through untouched
        sys.stdout.buffer.write(raw)
        return
    text = raw.decode("utf-8", errors="replace")
    if "json" in ctype:
        try:
            text = json.dumps(json.loads(text), indent=2, ensure_ascii=False)
        except json.JSONDecodeError:
            pass
    print(text)
    if status >= 400:
        sys.exit(1)


if __name__ == "__main__":
    main()
